### Admin sign in
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin"
}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    if (![200, 201].includes(response.status)) {
        throw new Error(`Admin sign in failed with status ${response.status}`);
    }
    client.global.set("adminToken", body.bearerToken);
%}

### Get admin profile
GET {{baseUrl}}/auth/profile
Content-Type: application/json
Authorization: Bearer {{adminToken}}

> {%
    if (![200, 201].includes(response.status)) {
        throw new Error(`Get admin profile failed with status ${response.status}`);
    }
%}

### Create user 1
POST {{baseUrl}}/auth/signup
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "user1@example.com",
  "name": "User 1",
  "password": "user1pass",
  "passwordConfirm": "user1pass"
}

> {%
    const body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
    if (![200, 201].includes(response.status)) {
        throw new Error(`Create user 1 failed with status ${response.status}`);
    }
    client.global.set("user1Id", body.user?.id || body.id);
%}

